# Local placeholders only. Never commit actual environment values.
DATABASE_URL=
STORE_ID=

# Configure only through secure environment settings.
APP_ORIGIN=
TELEGRAM_BOT_TOKEN=
# Secret given to Telegram setWebhook (32 to 256 characters: A-Z a-z 0-9 _ -). Telegram sends it back in a
# header on every update; investor accounts created by phone are linked through this webhook.
TELEGRAM_WEBHOOK_SECRET=

# Enable only for controlled testing with a configured database and staff session.
STAFF_WORKSPACE_ENABLED=false

# Customer records: disabled until privacy/security review and secure configuration.
CUSTOMER_RECORDS_ENABLED=false
CUSTOMER_DATA_KEY=

# Nasiya schedule activation: test only until business rules are approved.
INSTALLMENT_SCHEDULE_ENABLED=false

# Pricing policy in basis points (100 basis points = 1%). Set approved rates privately.
INSTALLMENT_MIN_INITIAL_BPS=
INSTALLMENT_MONTHLY_MARKUP_BPS=

# Funding records: enabled only in controlled test environments until reviewed.
INVESTOR_FUNDING_ENABLED=false

# Catalog changes and approved public image domains.
CATALOG_ADMIN_ENABLED=false
CATALOG_IMAGE_HOSTS=

# One-time activation of an operator-provisioned admin email. Remove after activation.
ADMIN_SETUP_CODE=

# Website checkout (guest purchase requests). Also needs CUSTOMER_RECORDS_ENABLED and CUSTOMER_DATA_KEY.
WEBSITE_CHECKOUT_ENABLED=false

# Telegram Login (OpenID Connect) for customers at checkout. From @BotFather > Login Widget.
# Leave empty to hide the Telegram button; the guest form keeps working.
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
